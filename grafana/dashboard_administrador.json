    {
      "id": 17,
      "type": "table",
      "title": "Verificações automáticas",
      "description": "Cada linha conta registros que não deveriam existir. 'Verificar' não quer dizer erro na hora: dados de demonstração com data futura, por exemplo, aparecem aqui de propósito.",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_KENTOCAFE}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${DS_KENTOCAFE}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT `Verificação`,\n       `Ocorrências`,\n       CASE WHEN `Ocorrências` = 0 THEN 'OK' ELSE 'Verificar' END AS `Situação`,\n       `Onde olhar`\nFROM (\nSELECT 1 AS ordem, 'Pedidos sem nenhum item' AS `Verificação`, (SELECT COUNT(*) FROM pedido p WHERE NOT EXISTS (SELECT 1 FROM item_pedido i WHERE i.pedido_id = p.id)) AS `Ocorrências`, 'Back: POST /pedidos deveria recusar carrinho vazio' AS `Onde olhar`\nUNION ALL\nSELECT 2 AS ordem, 'Valor do pedido diferente da soma dos itens' AS `Verificação`, (SELECT COUNT(*) FROM (\n        SELECT p.id FROM pedido p JOIN item_pedido i ON i.pedido_id = p.id\n        GROUP BY p.id, p.valor_total\n        HAVING ABS(p.valor_total - SUM(i.quantidade * i.preco_unidade)) > 0.01) t) AS `Ocorrências`, 'Back: cálculo do valor_total em PedidoService' AS `Onde olhar`\nUNION ALL\nSELECT 3 AS ordem, 'Pedidos prontos sem horário de pronto' AS `Verificação`, (SELECT COUNT(*) FROM pedido p JOIN status s ON s.id = p.status_id WHERE s.nome = 'Pronto' AND p.dt_hr_pronto IS NULL) AS `Ocorrências`, 'Back: concluir/atualizarStatus deve gravar dt_hr_pronto' AS `Onde olhar`\nUNION ALL\nSELECT 4 AS ordem, 'Horário de pronto antes do pedido' AS `Verificação`, (SELECT COUNT(*) FROM pedido WHERE dt_hr_pronto < dt_hr_pedido) AS `Ocorrências`, 'Banco: dt_hr_pronto < dt_hr_pedido' AS `Onde olhar`\nUNION ALL\nSELECT 5 AS ordem, 'Pedidos com data no futuro' AS `Verificação`, (SELECT COUNT(*) FROM pedido WHERE dt_hr_pedido > (UTC_TIMESTAMP() - INTERVAL 3 HOUR) + INTERVAL 5 MINUTE) AS `Ocorrências`, 'Dados de demonstração ou relógio do servidor errado' AS `Onde olhar`\nUNION ALL\nSELECT 6 AS ordem, 'Pedidos fora do horário de funcionamento (9h–18h)' AS `Verificação`, (SELECT COUNT(*) FROM pedido WHERE HOUR(dt_hr_pedido) < 9 OR HOUR(dt_hr_pedido) >= 18) AS `Ocorrências`, 'Fuso do servidor (Docker em UTC grava +3h) ou teste' AS `Onde olhar`\nUNION ALL\nSELECT 7 AS ordem, 'Pedidos em aberto de dias anteriores' AS `Verificação`, (SELECT COUNT(*) FROM pedido p JOIN status s ON s.id = p.status_id WHERE s.nome IN ('Pendente', 'Em preparo') AND DATE(p.dt_hr_pedido) < DATE(UTC_TIMESTAMP() - INTERVAL 3 HOUR)) AS `Ocorrências`, 'Tela de Pedidos: concluir ou cancelar' AS `Onde olhar`\nUNION ALL\nSELECT 8 AS ordem, 'Bebidas vendidas sem tamanho' AS `Verificação`, (SELECT COUNT(*) FROM item_pedido i WHERE i.tamanho_id IS NULL AND EXISTS (SELECT 1 FROM produto_tamanho pt WHERE pt.produto_id = i.produto_id)) AS `Ocorrências`, 'Front/back: item de produto com tamanhos precisa de tamanho_id' AS `Onde olhar`\nUNION ALL\nSELECT 9 AS ordem, 'Produtos ativos sem foto' AS `Verificação`, (SELECT COUNT(*) FROM produto WHERE ativo = 1 AND (path_ft IS NULL OR path_ft = '')) AS `Ocorrências`, 'Cadastro de produto: enviar imagem' AS `Onde olhar`\nUNION ALL\nSELECT 10 AS ordem, 'Produtos ativos sem preço' AS `Verificação`, (SELECT COUNT(*) FROM produto p WHERE p.ativo = 1 AND p.preco_unidade IS NULL AND NOT EXISTS (SELECT 1 FROM produto_tamanho pt WHERE pt.produto_id = p.id)) AS `Ocorrências`, 'Cadastro de produto: preço ou tamanhos' AS `Onde olhar`\nUNION ALL\nSELECT 11 AS ordem, 'Pedidos de funcionário desativado (últimos 30 dias)' AS `Verificação`, (SELECT COUNT(*) FROM pedido p JOIN funcionario f ON f.id = p.funcionario_id WHERE f.ativo = 0 AND p.dt_hr_pedido >= (UTC_TIMESTAMP() - INTERVAL 3 HOUR) - INTERVAL 30 DAY) AS `Ocorrências`, 'Login de funcionário desativado ainda funciona?' AS `Onde olhar`\nUNION ALL\nSELECT 12 AS ordem, 'Dias com pedido sem clima carregado' AS `Verificação`, (SELECT COUNT(*) FROM vw_dia d WHERE d.data < DATE(UTC_TIMESTAMP() - INTERVAL 3 HOUR) AND d.temp_max_c IS NULL) AS `Ocorrências`, 'Bases externas: rodar extração/tratamento do Open-Meteo' AS `Onde olhar`\nUNION ALL\nSELECT 13 AS ordem, 'Dias com pedido fora do calendário' AS `Verificação`, (SELECT COUNT(*) FROM vw_dia d WHERE NOT EXISTS (SELECT 1 FROM calendario c WHERE c.data = d.data)) AS `Ocorrências`, 'Bases externas: gerar calendário do ano' AS `Onde olhar`\nUNION ALL\nSELECT 14 AS ordem, 'Previsão de movimento desatualizada (mais de 1 dia)' AS `Verificação`, (SELECT CASE WHEN MAX(data_referencia) IS NULL THEN 1 ELSE GREATEST(DATEDIFF(DATE(UTC_TIMESTAMP() - INTERVAL 3 HOUR), MAX(data_referencia)) - 1, 0) END FROM modelo_execucao WHERE data_referencia <= DATE(UTC_TIMESTAMP() - INTERVAL 3 HOUR)) AS `Ocorrências`, 'Rodar modelo_previsao/treinar_previsao.py' AS `Onde olhar`\nUNION ALL\nSELECT 15 AS ordem, 'Imagens com falha definitiva no S3' AS `Verificação`, (SELECT COUNT(*) FROM s3_cleanup_outbox WHERE status = 'FALHA_FINAL') AS `Ocorrências`, 'Ver painel Imagens no S3' AS `Onde olhar`\n) v\nORDER BY (`Ocorrências` = 0), ordem"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
