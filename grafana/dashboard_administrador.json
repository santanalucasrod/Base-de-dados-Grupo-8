            "type": "mysql",
            "uid": "${DS_KENTOCAFE}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT UNIX_TIMESTAMP(DATE(p.dt_hr_pedido))                      AS time,\n       SUM(s.nome = 'Pronto')                                     AS `Prontos`,\n       SUM(s.nome = 'Cancelado')                                  AS `Cancelados`,\n       SUM(s.nome IN ('Pendente', 'Em preparo'))                  AS `Em aberto`\nFROM pedido p JOIN status s ON s.id = p.status_id\nWHERE $__timeFilter(p.dt_hr_pedido)\nGROUP BY UNIX_TIMESTAMP(DATE(p.dt_hr_pedido))\nORDER BY time"
        }
