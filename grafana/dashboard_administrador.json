    {
      "id": 8,
      "type": "table",
      "title": "Pedidos abertos (mais antigos primeiro)",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "${DS_KENTOCAFE}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${DS_KENTOCAFE}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT `Pedido`, `Cliente`, `Status`, `Feito em`, `Aberto há (min)`, `Itens prontos`, `Funcionário`\nFROM (\n    SELECT p.id                                                  AS `Pedido`,\n           p.nome_cliente                                        AS `Cliente`,\n           s.nome                                                AS `Status`,\n           DATE_FORMAT(p.dt_hr_pedido, '%d/%m %H:%i')            AS `Feito em`,\n           TIMESTAMPDIFF(MINUTE, p.dt_hr_pedido, (UTC_TIMESTAMP() - INTERVAL 3 HOUR))        AS `Aberto há (min)`,\n           CONCAT(SUM(ip.pronto), '/', COUNT(ip.id))             AS `Itens prontos`,\n           f.nome                                                AS `Funcionário`,\n           p.dt_hr_pedido                                        AS ordem\n    FROM pedido p\n    JOIN status s      ON s.id = p.status_id\n    JOIN funcionario f ON f.id = p.funcionario_id\n    LEFT JOIN item_pedido ip ON ip.pedido_id = p.id\n    WHERE s.nome IN ('Pendente', 'Em preparo')\n    GROUP BY p.id, p.nome_cliente, s.nome, p.dt_hr_pedido, f.nome\n    UNION ALL\n    -- sem pedidos abertos: uma linha avisando, em vez de \"No data\"\n    SELECT NULL, 'Nenhum pedido aberto', '', '', 0, '', '', NULL\n    FROM DUAL\n    WHERE NOT EXISTS (SELECT 1 FROM pedido p JOIN status s ON s.id = p.status_id WHERE s.nome IN ('Pendente', 'Em preparo'))\n) t\nORDER BY ordem IS NULL, ordem\nLIMIT 50"
        }
      ],
